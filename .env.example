# Copy to .env and fill in locally. NEVER commit real keys (spec 0.6, 11).
# Each owner edits only their own section (spec 18.6 rule 5). Flags default to the in-memory fakes.

# ============================== P1 — Spine ==============================
NODE_ENV=development
LOG_LEVEL=info
# memory = in-process stores (simulator/tests) | postgres = core.* tables
RUNTIME_STORE=memory
# postgres://campus_app_user:<APP_DB_PASSWORD>@localhost:5432/campus
#   or pglite://./.data/pglite for local Postgres without Docker
DATABASE_URL=
# Owner role used only by `pnpm db:migrate` (defaults to DATABASE_URL)
# postgres://campus_owner:<POSTGRES_PASSWORD>@localhost:5432/campus
DATABASE_URL_ADMIN=
REDIS_URL=redis://localhost:6379
# docker-compose only (local dev passwords; pick your own)
POSTGRES_USER=campus_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
GATEWAY_DB_PASSWORD=

USE_REAL_MODEL=false
# anthropic | gemini
MODEL_PROVIDER=anthropic
# The key for MODEL_PROVIDER (Anthropic API key, or Gemini API key from Google AI Studio)
MODEL_API_KEY=
# Optional; defaults to claude-opus-5-5 (anthropic) or gemini-3.8-flash (gemini)
MODEL_NAME=
# low | medium | high | xhigh | max  (Gemini uses low/medium/high; xhigh/max → high)
MODEL_EFFORT=medium
MODEL_STRUCTURED_OUTPUT=true

AGENT_DISPLAY_NAME=Campus Agent
AGENT_INVOCATION_NAMES=@agent,agent,campus agent

TURN_MAX_MODEL_STEPS=4
TURN_MAX_TOOL_CALLS=6
TURN_TIMEOUT_MS=90000
MODEL_CALL_TIMEOUT_MS=45000
TOOL_CALL_TIMEOUT_MS=15000
TURN_MAX_TOKENS=150000
MODEL_MAX_OUTPUT_TOKENS=4096
RATE_LIMIT_USER_MODEL_CALLS_PER_10MIN=40
RATE_LIMIT_CONVERSATION_MODEL_CALLS_PER_10MIN=80

QUEUE_MAX_ATTEMPTS=5
WORKER_POLL_INTERVAL_MS=250
WORKER_CONCURRENCY=4
RUN_WORKER_IN_PROCESS=false
API_PORT=3000
TRACE_API_ENABLED=true
# Required when NODE_ENV=production and the trace API is enabled
TRACE_API_TOKEN=
GROUP_MEAL_OPTIONS_TOOL=dining__search_options

# ============================== P2 — Front door ==============================
# iMessage through a BlueBubbles Server (a Mac signed into the bot's Apple ID). Setup: apps/web/README.md
USE_REAL_MESSAGING=false
USE_REAL_IDENTITY=false
# BlueBubbles Server URL (its own ngrok/Cloudflare URL) and server password
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
# Long random string. Register this webhook URL in BlueBubbles (event "New Messages"):
#   <APP_ORIGIN>/webhooks/bluebubbles?token=<BLUEBUBBLES_WEBHOOK_SECRET>
BLUEBUBBLES_WEBHOOK_SECRET=
# The bot's iMessage address people text (phone in +1... form, or its Apple ID email)
BLUEBUBBLES_BOT_ADDRESS=
# apple-script (default) | private-api (needs the BlueBubbles Private API helper; enables in-thread replies)
BLUEBUBBLES_SEND_METHOD=apple-script
BLUEBUBBLES_INLINE_REPLIES=false
BLUEBUBBLES_MAX_SENDS_PER_SECOND=2
# Public URL of THIS API server (sign-up links point here). With ngrok: https://<id>.ngrok-free.app
APP_ORIGIN=http://localhost:3000
NUDGE_INTERVAL_HOURS=6
# Real food orders (interim Grubhub connector, unofficial — see packages/grubhub/README.md):
# fake = test data | grubhub = real restaurants/orders (sign in: pnpm --filter @campus/grubhub login,
# each person who orders texts the assistant "connect grubhub" to link their own account)
DINING_PROVIDER=fake
DELIVERY_LATITUDE=
DELIVERY_LONGITUDE=
# Delivery address + courier contact (required with grubhub; set on every cart)
DELIVERY_STREET=
DELIVERY_UNIT=
DELIVERY_CITY=
DELIVERY_STATE=
DELIVERY_POSTAL_CODE=
DELIVERY_INSTRUCTIONS=
DELIVERY_PHONE=
DELIVERY_EMAIL=
GRUBHUB_MAX_ORDER_MINOR=8000
# Actually place orders (charges the payer's saved card). Off until the checkout calls are verified.
GRUBHUB_CHECKOUT_ENABLED=false

# ============================== P3 — Memory ==============================
USE_REAL_MEMORY=false
SUPERMEMORY_API_KEY=
# How often new group chat messages are batched into each group's memory (ms; 0 = off)
MEMORY_GROUP_INGEST_INTERVAL_MS=60000

# ============================== P4 — Hands ==============================
USE_REAL_TOOLS=false
# postgres://campus_gateway_user:<GATEWAY_DB_PASSWORD>@localhost:5432/campus
DATABASE_URL_VAULT=
VAULT_KEY_ID=
# dev only; use a KMS/secret store otherwise
VAULT_MASTER_KEY=
COMPOSIO_API_KEY=
OAUTH_REDIRECT_BASE=http://localhost:3000/oauth/callback
SPENDING_CEILING_MINOR=3000
